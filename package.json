{
  "name": "dnd-slides",
  "version": "1.1.1",
  "description": "D&D Monster Display for DM sessions",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder -- --mac",
    "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^30.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0"
  },
  "dependencies": {
    "express": "^4.21.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.7.0"
  },
  "build": {
    "appId": "com.dnd-slides",
    "productName": "DnD Slides",
    "asar": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "electron/**",
      "!__tests__/**",
      "!babel.config.js",
      "!AGENTS.MD",
      "!claude.MD"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
